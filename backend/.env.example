# Zenith Backend Environment Configuration Example
PROJECT_NAME="Zenith Dynamic Hotel Pricing Engine"
ENVIRONMENT="development"
DATABASE_URL="sqlite+aiosqlite:///./zenith_hotel.db"
# Optional: REDIS_URL="redis://localhost:6379/0"
CACHE_DEFAULT_TTL=300
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","*"]
